# Copy to .env (or just export the variables). Everything is optional.

# Address of a Redline deployment on Studionet. `npm run deploy` prints it.
# Without it, `npm run e2e` deploys a fresh contract for the run.
REDLINE_CONTRACT_ADDRESS=

# Private keys for the two test accounts. Throw-away keys are generated when unset.
REDLINE_PRIVATE_KEY=
REDLINE_PRIVATE_KEY_2=

# Where the fixtures in e2e/fixtures are served from (raw text, one file per name).
# Default: https://raw.githubusercontent.com/$GITHUB_REPOSITORY/main/e2e/fixtures
# (GITHUB_REPOSITORY is set automatically inside Codespaces / GitHub Actions; otherwise the
# script reads `git remote origin`). Push e2e/fixtures to that branch before running.
E2E_FIXTURE_BASE=

# Public Studionet RPC allows ~30 requests/minute; the scripts stay under this many.
E2E_RPC_PER_MINUTE=22
